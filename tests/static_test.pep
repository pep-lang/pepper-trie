# format: on

_widths(): trie.StaticTrieBuilder {
    var builder = trie.StaticTrieBuilder(1);
    builder.set_range(0, 0x1F, 0);
    builder.set_range(0x300, 0x36F, 0);
    builder.set_range(0x1100, 0x115F, 2);
    builder.set_range(0x4E00, 0x9FFF, 2);
    builder.set_range(0x20000, 0x3FFFD, 2);
    builder.set_range(0xE0100, 0xE01EF, 0);
    return builder;
}

[Test]
a_constant_trie_reads_its_builder() {
    var builder = _widths();
    ulong wrong = 0;
    for (var cp in 0..(trie.MAX_KEY + 1) as ulong) {
        if (_WIDTHS.get(cp as uint) as uint != builder.get(cp as uint)) {
            wrong += 1;
        }
    }
    expect_equal(wrong, 0 as ulong);
    expect_equal(_WIDTHS.get(0x4E2D), 2 as u8);
    expect_equal(_WIDTHS.get(0x301), 0 as u8);
}

[Test]
the_builder_still_writes_the_constant() {
    var data = _widths().build(trie.StaticTrieKind.Small);
    expect_equal(data.bytes.count, _WIDTHS.data.size);
    var same = true;
    for (var i in 0..data.bytes.count) {
        if (data.bytes[i] as int != _WIDTHS.data.byte_at(i) as int) {
            same = false;
        }
    }
    expect_true(same);
}
